        "sheng_perf_libperfgluelayer",
        "sheng_perf_libqti_perfd_client",
        "libc++",
        "libc",
        "libm",
        "libdl"
    ],
    vendor: true,
    stem: "vendor.qti.hardware.perf-hal-service",
    relative_install_path: "hw",
    init_rc: [
        "etc/init/vendor.qti.hardware.perf-hal-service.rc"
    ],
    vintf_fragments: [
        "etc/vintf/manifest/vendor.qti.hardware.perf.xml"
    ]
}


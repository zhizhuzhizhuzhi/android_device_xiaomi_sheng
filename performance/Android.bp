cc_prebuilt_binary {
    name: "sheng_perf_vendor_qti_hardware_perf_hal_service",
    srcs: [
        "bin/hw/vendor.qti.hardware.perf-hal-service"
    ],
    compile_multilib: "64",
    strip: {
        none: true
    },
    shared_libs: [
        "liblog",
        "libcutils",
        "libbase",
        "libutils",
        "libhardware_legacy",
        "libhardware",
        "libhidlbase",
        "vendor.qti.hardware.perf@2.0",

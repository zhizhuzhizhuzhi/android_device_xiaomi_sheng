    visibility: ["//visibility:public"],
}
filegroup {
    name: "sheng_stock_display_vendor.xiaomi.hardware.displayfeature@1.0",
    srcs: ["prebuilts/display/lib64/vendor.xiaomi.hardware.displayfeature@1.0.so"],
    visibility: ["//visibility:public"],
}
filegroup { name: "sheng_display_composer_init", srcs: ["prebuilts/display/vendor.qti.hardware.display.composer-service.rc"], visibility: ["//visibility:public"] }
filegroup { name: "sheng_display_composer_manifest", srcs: ["prebuilts/display/vendor.qti.hardware.display.composer-service.xml"], visibility: ["//visibility:public"] }

 # Disable the poweropt service for <5.4 platforms.
 ifneq (,$(filter 4.14 4.19, $(TARGET_KERNEL_VERSION)))
@@ -34,7 +39,7 @@
 
 # Properties
 PRODUCT_VENDOR_PROPERTIES += \
